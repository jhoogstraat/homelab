{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^quadlets/.*\\.container$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nImage=\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "automerge": false,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Image pins (Quadlets, Containerfiles) take digest and patch updates on their own once CI passes; minor and major updates wait for review.",
      "matchManagers": [
        "custom.regex",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Fedora publishes the next release's tag while it is still in development; open its PR only when approved on the Dependency Dashboard.",
      "matchDepNames": [
        "quay.io/fedora/fedora-bootc"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
