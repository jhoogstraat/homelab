{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^quadlets/.*\\.container$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nImage=\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "endoflife.date lists a Fedora release only once it is generally available; the fedora-bootc tag exists months earlier.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "FROM quay\\.io/fedora/fedora-bootc:(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "fedora",
      "datasourceTemplate": "endoflife-date",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "automerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Image pins (Quadlets, Containerfiles) take digest, patch and minor updates on their own once CI passes; major updates wait for review.",
      "matchManagers": [
        "custom.regex",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "GitHub Actions take digest and patch updates on their own once CI passes.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The Fedora base follows the fedora dependency below, not its own tags: the next release's tag appears while it is still in development.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "quay.io/fedora/fedora-bootc"
      ],
      "enabled": false
    },
    {
      "description": "A new Fedora release merges on its own 30 days after general availability, once its early problems are known.",
      "matchDepNames": [
        "fedora"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days",
      "automerge": true
    }
  ]
}
