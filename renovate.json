{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "mise"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^quadlets/.*\\.container$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nImage=\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Depanator and second-brain publish only sha-* and latest tags; follow latest's digest and merge once CI passes.",
      "matchDepNames": [
        "ghcr.io/jhoogstraat/depanator",
        "ghcr.io/jhoogstraat/second-brain"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ]
}
