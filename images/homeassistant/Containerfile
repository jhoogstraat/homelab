# 2026.11.3 still ships CVE-2026-123158 (openssh-client) and CVE-2026-96760 (Authlib 1.7.2).
# Drop this recipe once an upstream release scans clean.
FROM ghcr.io/home-assistant/home-assistant:2026.11.3@sha256:ee500645d61b5483d0b05eebd4f2de22c390618ec178df0e1114a77d40d6d650
RUN apk upgrade --no-cache
COPY images/homeassistant/requirements.txt /tmp/requirements.txt
# PyPI only, so the pinned hash matches.
RUN PIP_EXTRA_INDEX_URL= pip install --no-cache-dir --no-deps --require-hashes \
      --index-url https://pypi.org/simple -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
