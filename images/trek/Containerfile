# 5.0.0 still ships CVE-2026-6653 (libxml2, no fixed Debian package).
# Drop this recipe once an upstream release scans clean.
FROM docker.io/mauriceboe/trek:5.0.0@sha256:0c0a8f5b488fc2967248695e04bb000bb177d0b63d3385089d33dca6fde4daf9
USER root
# The optional KItinerary extractor pulls in Debian's unpatched libxml2.
# TREK handles its absence; manual planning and provider-based AI parsing remain.
RUN apt-get purge -y libkitinerary-bin libxml2 && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /usr/local/bin/kitinerary-extractor
ENV KITINERARY_EXTRACTOR_PATH=""
