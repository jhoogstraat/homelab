[Unit]
Description=Cloudflare Daemon for a ZeroTrust Tunnel
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=cloudflared
# renovate: datasource=docker depName=docker.io/cloudflare/cloudflared
Image=docker.io/cloudflare/cloudflared:latest@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
UserNS=auto

Network=homelab.network:ip=10.90.0.9

EnvironmentFile=/var/lib/homelab/secrets/%p.env

Exec=tunnel --no-autoupdate run

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
