[Unit]
Description=Cloudflare Daemon for a ZeroTrust Tunnel
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=cloudflared
# renovate: datasource=docker depName=docker.io/cloudflare/cloudflared
Image=docker.io/cloudflare/cloudflared:latest@sha256:b94b96edf2c9c4360f8879c8580cfaa99077f19c849ec595ca2f711b27d4f344
UserNS=auto

Network=homelab.network:ip=10.90.0.9

Volume=/run/homelab/secrets/current/cloudflared:/run/secrets:ro,Z,idmap=uids=@0-65532-1;gids=@0-65532-1

Exec=tunnel --no-autoupdate run --token-file /run/secrets/tunnel-token

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
