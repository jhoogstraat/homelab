[Unit]
Description=OpenThread Border Router
StartLimitIntervalSec=0

[Container]
ContainerName=otbr
# Patched ARM64 artifact; rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:otbr-sha-c575b97083e7a1b65ee8e3e85af1e9c571494036@sha256:769074b41b71e0a5103a3ff148d0a7cc850d9bf3d1ceab60a9b24bd9d3d529e9

Network=host

AddCapability=NET_ADMIN
AddCapability=NET_RAW

AddDevice=/dev/serial/by-id/usb-Itead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_V2_56fc5dba521fef11a58a4ad0639e525b-if00-port0:/dev/ttyUSB0
AddDevice=/dev/net/tun

Volume=/var/lib/homelab/apps/%p/data:/data:Z,idmap

EnvironmentFile=/var/lib/homelab/environment/%p/%p.env

# Host networking: border-router sysctls live in /usr/lib/sysctl.d/60-homelab-network.conf.

Label=traefik.enable=true
Label=traefik.http.services.%p.loadbalancer.server.port=7070

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=100
TimeoutStopSec=100

[Install]
WantedBy=homelab.target
