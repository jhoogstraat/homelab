[Unit]
Description=TREK travel planner
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=trek
# Patched ARM64 artifact (images/trek); rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:trek-sha-bd7fa1b3221897e3100111c68bf76487e80078fd@sha256:251b326b33b1489c14cd8c7cfd2028e5a162bc8f61235501d22858f808dbd4b0
UserNS=auto
Network=homelab.network:ip=10.90.0.15
Volume=/var/lib/homelab/apps/%p/data:/app/data:Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Volume=/var/lib/homelab/apps/%p/data/uploads:/app/uploads:Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=APP_URL=https://trek.hoogstraat.net
Environment=ALLOWED_ORIGINS=https://trek.hoogstraat.net
Environment=FORCE_HTTPS=true
Environment=TRUST_PROXY=1
Environment=TZ=Europe/Berlin
# Document sync reaches Papra at http://papra:1221; TREK's SSRF guard blocks private IPs otherwise.
Environment=ALLOW_INTERNAL_NETWORK=true
# Bootstrap credentials and optional provider keys belong to device-owned config.
EnvironmentFile=/var/lib/homelab/apps/%p/config/app.env
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=128m
DropCapability=ALL
AddCapability=CHOWN SETUID SETGID
NoNewPrivileges=true
HealthCmd=wget -qO- --header="X-Forwarded-Proto: https" http://localhost:3000/api/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=homelab.target
