[Unit]
Description=Depanator apartment agent
ConditionPathExists=!/var/lib/homelab/apps/depanator/data/reconciliation-required

[Container]
ContainerName=depanator
# renovate: datasource=docker depName=ghcr.io/jhoogstraat/depanator
Image=ghcr.io/jhoogstraat/depanator:latest@sha256:670a83bfac0cb18a44e8e3e42cd205fa6e76fbb412872d4563b840be2d3f4e88
Pull=missing
StopTimeout=40
UserNS=auto
User=1000
Group=1000
Network=public.network:ip=10.92.0.16
Volume=/var/lib/homelab/apps/depanator/data:/data:Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Volume=/run/homelab/secrets/current/depanator:/run/secrets:ro,Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Environment=TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
Environment=DEPANATOR_PUBLIC_URL=https://depanator.hoogstraat.net
DropCapability=ALL
NoNewPrivileges=true
Label=traefik.enable=true
Label=traefik.docker.network=public
Label=traefik.http.routers.depanator.rule=Host(`depanator.hoogstraat.de`)
Label=traefik.http.routers.depanator.entrypoints=https
Label=traefik.http.routers.depanator.service=depanator
Label=traefik.http.services.depanator.loadbalancer.server.port=8080
HealthCmd=/usr/local/bin/depanator-entrypoint health
HealthInterval=5m
HealthTimeout=10s
HealthStartPeriod=15m
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStopSec=60
MemoryMax=2G
