[Unit]
Description=Depanator apartment agent
Wants=adguard.container
After=adguard.container
ConditionPathExists=/var/lib/homelab/apps/depanator/config/config.json
ConditionPathExists=/run/homelab/secrets/current/depanator/telegram-bot-token
ConditionPathExists=!/var/lib/homelab/apps/depanator/data/reconciliation-required
StartLimitIntervalSec=0

[Container]
ContainerName=depanator
Image=ghcr.io/jhoogstraat/depanator@sha256:3da45c5c55b35b775eba86ea7cbf790f594769fe7a529555c7288cdf856d40f8
UserNS=auto
User=1000
Group=1000
Network=homelab.network
NetworkAlias=depanator
Volume=/var/lib/homelab/apps/%p/config:/config:ro,Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Volume=/var/lib/homelab/apps/%p/data:/data:Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Volume=/run/homelab/secrets/current/%p:/run/secrets:ro,Z,idmap=uids=@0-1000-1;gids=@0-1000-1
Environment=TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
Environment=VNC_PASSWORD_FILE=/run/secrets/vnc-password
ShmSize=256m
StopTimeout=40
Exec=start
Label="traefik.enable=true"
Label="traefik.http.routers.depanator.entrypoints=https"
Label="traefik.http.services.depanator.loadbalancer.server.port=6080"
Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60
MemoryMax=2G

[Install]
WantedBy=homelab.target
