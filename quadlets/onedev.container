[Unit]
Description=OneDev
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=onedev
Image=docker.io/1dev/server:latest
AutoUpdate=registry
UserNS=auto

Network=homelab.network:ip=10.90.0.15

Volume=/var/lib/homelab/apps/%p/data:/opt/onedev:Z,idmap

Label="traefik.enable=true"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30


[Install]
WantedBy=homelab.target
