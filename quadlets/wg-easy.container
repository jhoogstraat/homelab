[Unit]
Description=Wireguard Easy (wg-easy)
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=wg-easy
Image=ghcr.io/wg-easy/wg-easy:15
AutoUpdate=registry

Network=homelab.network:ip=10.90.0.16
PublishPort=51820:51820/udp

Volume=/var/lib/homelab/apps/%p/data:/etc/wireguard:Z

Label="traefik.enable=true"
Label="traefik.http.services.%p.loadbalancer.server.port=51821"
Label="subdomain=wg"

AddCapability=NET_ADMIN
AddCapability=SYS_MODULE
AddCapability=NET_RAW

Sysctl=net.ipv4.ip_forward=1
Sysctl=net.ipv4.conf.all.src_valid_mark=1
Sysctl=net.ipv6.conf.all.disable_ipv6=0
Sysctl=net.ipv6.conf.all.forwarding=1
Sysctl=net.ipv6.conf.default.forwarding=1


Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=100


[Install]
WantedBy=homelab.target
