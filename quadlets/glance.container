[Unit]
Description=Glance
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=glance
# renovate: datasource=docker depName=docker.io/glanceapp/glance
Image=docker.io/glanceapp/glance:latest@sha256:bc5a392672c1ec8823c50b61f3bd4b7e5acc34fcbb8477862577b3af1c633875
UserNS=auto

Network=homelab.network:ip=10.90.0.4

Volume=/var/lib/homelab/apps/%p/config:/app/config:Z,idmap

Volume=/run/homelab/secrets/current/glance:/run/secrets:ro,Z,idmap

Label="traefik.enable=true"
Label="traefik.http.routers.glance.entrypoints=https"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
