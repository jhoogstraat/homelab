[Unit]
Description=Papra document management
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=papra
# Patched ARM64 artifact; rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:papra-sha-c097dcfe839b565b5b05f0ccb11ef0c1cbd2e600@sha256:72d5d8ac10a1c06cd91e909ec3dbc1befaba855d533454c09f6ecc8b27f858c4
UserNS=auto

Network=homelab.network:ip=10.90.0.11

# User inside container is `nonroot` (uid:gid 999:999), so map root to this uid/gid.
# Because of UserNS=auto, the `podman run` process is run with a random uid/gid, which has to be taken into account (@).
Volume=/var/lib/homelab/apps/%p/data:/app/app-data:Z,idmap=uids=@0-999-1;gids=@0-999-1
Volume=/var/lib/homelab/apps/%p/ingestion:/app/ingestion:Z,idmap=uids=@0-999-1;gids=@0-999-1

EnvironmentFile=/var/lib/homelab/environment/%p/papra.env
EnvironmentFile=/var/lib/homelab/apps/%p/config/app.env
Volume=/run/homelab/secrets/current/papra:/run/secrets:ro,Z,idmap=uids=@0-999-1;gids=@0-999-1
Environment=NODE_OPTIONS=--import=/run/secrets/load-env.mjs

Label="traefik.enable=true"
Label="traefik.http.routers.papra.entrypoints=https"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
