[Unit]
Description=Traefik Reverse Proxy
Wants=adguard.container podman.socket
After=adguard.container podman.socket
StartLimitIntervalSec=0

[Container]
ContainerName=traefik
Image=docker.io/traefik:3
AutoUpdate=registry
UserNS=auto

Network=homelab.network:ip=10.90.0.3

PublishPort=443:443

SecurityLabelDisable=true

Volume=/var/lib/homelab/environment/%p:/etc/traefik:ro,Z,idmap
Volume=/var/lib/homelab/apps/%p/data:/opt/traefik:Z,idmap
Volume=%t/podman/podman.sock:/var/run/docker.sock:idmap

Environment=ACME_DNS_API_BASE=https://auth.acme-dns.io
Environment=ACME_DNS_STORAGE_PATH=/opt/traefik/.lego-acme-dns-accounts.json

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30


[Install]
WantedBy=homelab.target
