[Unit]
Description=Traefik Reverse Proxy
Requires=socket-proxy.container
Wants=adguard.container
After=adguard.container socket-proxy.container
StartLimitIntervalSec=0

[Container]
ContainerName=traefik
# renovate: datasource=docker depName=docker.io/traefik
Image=docker.io/traefik:3@sha256:e9338a01a43389362bdef90afd4ff4a30dd6c0a2e1b0ce00c5e0f52659aa2d9c
UserNS=auto

Network=homelab.network:ip=10.90.0.3
Network=podman-api.network

# Host-network services must use the app bridge, not the isolated API gateway.
AddHost=host.docker.internal:10.90.0.1
AddHost=host.containers.internal:10.90.0.1

PublishPort=443:443

Volume=/var/lib/homelab/environment/%p:/etc/traefik:ro,Z,idmap
Volume=/var/lib/homelab/apps/%p/data:/opt/traefik:Z,idmap

Environment=ACME_DNS_API_BASE=https://auth.acme-dns.io
Environment=ACME_DNS_STORAGE_PATH=/opt/traefik/.lego-acme-dns-accounts.json

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
