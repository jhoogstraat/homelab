[Unit]
Description=Restricted Podman discovery and monitoring API
Requires=podman.socket
After=podman.socket
StartLimitIntervalSec=0

[Container]
ContainerName=socket-proxy
# Patched ARM64 artifact; rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:socket-proxy-sha-08ecc8068a066cbf66389fbb85e1349274fcbf6d@sha256:8c7eec87749af440b6c1af41455770003ab40b1b6a70e0ca9a7d3723745cc52e
Network=podman-api.network

# This broker is the only application allowed to open the rootful API socket.
SecurityLabelDisable=true
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true
User=root
Volume=/var/lib/homelab/environment/%p/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
Volume=%t/podman/podman.sock:/var/run/podman.sock:ro

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
