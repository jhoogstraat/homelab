[Unit]
Description=Adguard Home DNS Server
StartLimitIntervalSec=0

[Container]
ContainerName=adguard
# renovate: datasource=docker depName=docker.io/adguard/adguardhome
Image=docker.io/adguard/adguardhome:latest@sha256:e2e1b48c832f7705be915873f95de0d5114de573736441d7f2923a8a6293027c
UserNS=auto

Network=homelab.network:ip=10.90.0.2

# Cannot bind on all interfaces, because aardvark-dns binds 53 on bridge interface for internal container DNS resolution.
# Also, systemd-resolved normally binds port 53. That listener is disabled by scripts/build-host.
PublishPort=192.168.0.3:53:53/tcp
PublishPort=192.168.0.3:53:53/udp

Volume=/var/lib/homelab/apps/%p/config:/opt/adguardhome/conf:Z,idmap
Volume=/var/lib/homelab/apps/%p/data:/opt/adguardhome/work:Z,idmap

Label="traefik.enable=true"
Label="traefik.http.routers.adguard.entrypoints=https"
Label="traefik.http.services.%p.loadbalancer.server.port=80"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=homelab.target
