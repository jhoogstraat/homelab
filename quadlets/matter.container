[Unit]
Description=Open Home Foundation Matter(.js) Server
StartLimitIntervalSec=0

[Container]
ContainerName=matter
# Patched ARM64 artifact; rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:matter-sha-e4f211a42f79ef04f62f0ec01c5e581410383891@sha256:7321f9636a2438a3f2bdc1b7a026d2eda904bf370e259e7222a288e3d46e9315

Network=host

User=root

AddCapability=NET_ADMIN
AddCapability=NET_RAW

Volume=/var/lib/homelab/apps/%p/data:/data:Z,idmap

# For bluetooth commissioning via HA or the Dashboard
Environment=BLUETOOTH_ADAPTER=0
Environment=LOG_LEVEL=info
Environment=PRIMARY_INTERFACE=end0

Label=traefik.enable=true
Label=traefik.http.services.%p.loadbalancer.server.port=5580

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=100
TimeoutStopSec=100
