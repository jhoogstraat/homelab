[Unit]
Description=Open Home Foundation Matter(.js) Server
Requires=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=0

[Container]
ContainerName=matter
# renovate: datasource=docker depName=ghcr.io/matter-js/matterjs-server
Image=ghcr.io/matter-js/matterjs-server:1.5.5@sha256:ee149c7c67eff0e90f131e8f0d628f7b099591ec58473c8cda1209e8ae4df66e

Network=host

User=root

AddCapability=NET_ADMIN
AddCapability=NET_RAW

# Allow access to the host D-Bus socket under SELinux, as for Home Assistant.
SecurityLabelType=spc_t

Volume=/var/lib/homelab/apps/%p/data:/data:Z,idmap
Volume=/run/dbus:/run/dbus:ro

# Share the adapter through host BlueZ instead of opening raw HCI sockets.
Environment=NOBLE_BINDINGS=dbus
Environment=BLUETOOTH_ADAPTER=0
Environment=LOG_LEVEL=info
Environment=PRIMARY_INTERFACE=end0

Label=traefik.enable=true
Label=traefik.http.services.%p.loadbalancer.server.port=5580

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=100
TimeoutStopSec=100

[Install]
WantedBy=homelab.target
