[Unit]
Description=Home Assistant
StartLimitIntervalSec=0

[Container]
ContainerName=homeassistant
StopTimeout=60
# Patched ARM64 artifact (images/homeassistant); rebuild and scan before changing this pin.
Image=ghcr.io/jhoogstraat/homelab:homeassistant-sha-c575b97083e7a1b65ee8e3e85af1e9c571494036@sha256:c065fd2d3386291e315a2f16c473fb5f0424cc5fdae3d433c9e1520ed8ad4d4a

Network=host

User=root

AddCapability=NET_ADMIN
AddCapability=NET_RAW

# Required for SELinux allowing access to certain hardware devices, such as Bluetooth
SecurityLabelType=spc_t

Volume=/var/lib/homelab/apps/%p/config:/config:Z
Volume=/run/dbus:/run/dbus:ro

Label="traefik.enable=true"
Label="traefik.http.routers.homeassistant.entrypoints=https"
Label="traefik.http.services.%p.loadbalancer.server.port=8123"
Label="subdomain=ha"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=100
TimeoutStopSec=100

[Install]
WantedBy=homelab.target
