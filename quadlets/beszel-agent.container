[Unit]
Description=Beszel Agent
Requires=beszel.pod
Wants=podman.socket
After=beszel.pod podman.socket
StartLimitIntervalSec=0

[Container]
ContainerName=beszel-agent
Image=docker.io/henrygd/beszel-agent:latest
AutoUpdate=registry

Pod=beszel.pod

# Podman socket connection with SELinux (https://github.com/containers/podman/discussions/9860#discussioncomment-545142)
SecurityLabelDisable=true

Volume=/var/lib/homelab/apps/beszel-agent/data:/var/lib/beszel-agent:Z,idmap
Volume=%t/podman/podman.sock:/var/run/docker.sock:idmap

Environment=HUB_URL=http://localhost:8090
EnvironmentFile=/var/lib/homelab/secrets/beszel.env

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60


[Install]
WantedBy=homelab.target
