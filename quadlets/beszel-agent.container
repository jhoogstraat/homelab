[Unit]
Description=Beszel Agent
Requires=beszel.pod socket-proxy.container
After=beszel.pod socket-proxy.container
StartLimitIntervalSec=0

[Container]
ContainerName=beszel-agent
# renovate: datasource=docker depName=docker.io/henrygd/beszel-agent
Image=docker.io/henrygd/beszel-agent:latest@sha256:f27b1aa2c68404bc5b9e1a2ab36653bd9b4ee14f6299862f09cd5051a4134767

Pod=beszel.pod

Volume=/var/lib/homelab/apps/beszel-agent/data:/var/lib/beszel-agent:Z,idmap

Environment=HUB_URL=http://localhost:8090
Environment=DOCKER_HOST=tcp://socket-proxy:2375
EnvironmentFile=/var/lib/homelab/secrets/beszel.env

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=homelab.target
