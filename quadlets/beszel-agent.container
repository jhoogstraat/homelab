[Unit]
Description=Beszel Agent
Requires=beszel.pod socket-proxy.container
After=beszel.pod socket-proxy.container
StartLimitIntervalSec=0

[Container]
ContainerName=beszel-agent
# renovate: datasource=docker depName=docker.io/henrygd/beszel-agent
Image=docker.io/henrygd/beszel-agent:latest@sha256:cb6868012964d7a68debaa2c84bb72285e5f08531e81f506bd4c493bf052e41c

Pod=beszel.pod

Volume=/var/lib/homelab/apps/beszel-agent/data:/var/lib/beszel-agent:Z,idmap

Environment=HUB_URL=http://localhost:8090
Environment=DOCKER_HOST=tcp://socket-proxy:2375
Volume=/run/homelab/secrets/current/beszel-agent:/run/secrets:ro,Z,idmap
Environment=TOKEN_FILE=/run/secrets/token
Environment=KEY_FILE=/run/secrets/key

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=homelab.target
