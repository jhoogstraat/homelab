[Unit]
Description=Vaultwarden (Bitwarden in Rust)
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=vaultwarden
Image=ghcr.io/jhoogstraat/homelab:vaultwarden-sha-fc63a20a44ff1ffa19d3a5d7797a42185e7c8f3a@sha256:d2e737a578b96affc04331905cc7ab504fa44ec14880cfb98b16eb2a44d854ea
UserNS=auto

Network=homelab.network:ip=10.90.0.7
HostName=vaultwarden

Volume=/var/lib/homelab/apps/%p/data:/data:Z,idmap

Environment=DOMAIN=https://vault.hoogstraat.net
Environment=SIGNUPS_ALLOWED=false

Volume=/run/homelab/secrets/current/vaultwarden:/run/secrets:ro,Z,idmap
Environment=ADMIN_TOKEN_FILE=/run/secrets/admin-token

Label="traefik.enable=true"
Label="traefik.http.routers.vaultwarden.entrypoints=https"
Label="subdomain=vault"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=homelab.target
