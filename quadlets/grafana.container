[Unit]
Description=Grafana Visualization
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=grafana
Image=docker.io/grafana/grafana:latest
AutoUpdate=registry
UserNS=auto
User=0

Network=homelab.network:ip=10.90.0.21

Volume=/var/lib/homelab/apps/%p/data:/var/lib/grafana:Z,idmap

EnvironmentFile=/var/lib/homelab/secrets/%p.env
EnvironmentFile=/var/lib/homelab/apps/%p/config/app.env

Label="traefik.enable=true"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30


[Install]
WantedBy=homelab.target
