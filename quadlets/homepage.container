[Unit]
Description=Personal homepage
Wants=adguard.container
After=adguard.container
StartLimitIntervalSec=0

[Container]
ContainerName=homepage
# renovate: datasource=docker depName=ghcr.io/jhoogstraat/homepage
Image=ghcr.io/jhoogstraat/homepage:latest@sha256:a6a4aec279bf1fefa44f9b347ed9f9def3f4b50a0c899100940a7e5e260917e4
Pull=newer

UserNS=auto
RunInit=true

Network=homelab.network:ip=10.90.0.5

Volume=/var/lib/homelab/apps/%p/data:/app/.spotify:Z,idmap

EnvironmentFile=/var/lib/homelab/environment/%p/%p.env
EnvironmentFile=/var/lib/homelab/secrets/%p.env

Label="traefik.enable=true"
Label="traefik.http.routers.homepage.entrypoints=https"

Timezone=local

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30
