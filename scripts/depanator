#!/usr/bin/python3
"""Depanator maintenance using the production mount mapping."""

import argparse
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import subprocess


loader = importlib.machinery.SourceFileLoader("homelab", str(Path(__file__).with_name("homelab")))
spec = importlib.util.spec_from_loader(loader.name, loader)
homelab = importlib.util.module_from_spec(spec)
loader.exec_module(homelab)
APP = homelab.ROOT / "apps/depanator"


def image():
    path = homelab.QUADLETS / "depanator.container"
    return next(line.removeprefix("Image=") for line in path.read_text().splitlines()
                if line.startswith("Image="))


def status():
    mapping = "Z,idmap=uids=@0-1000-1;gids=@0-1000-1"
    homelab.command("podman", "run", "--rm", "--pull=never", "--userns=auto", "--user=1000:1000",
                    "-v", f"{APP / 'config'}:/config:ro,{mapping}", "-v", f"{APP / 'data'}:/data:{mapping}",
                    image(), "status")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("status", "restore-gate"))
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError("Run with sudo")
    with homelab.maintenance():
        if subprocess.run(["systemctl", "is-active", "--quiet", "depanator.service"],
                          check=False).returncode == 0:
            raise RuntimeError("Stop depanator.service before running maintenance")
        for path in (APP, APP / "config", APP / "data"):
            path.mkdir(parents=True, mode=0o700, exist_ok=True)
            path.chmod(0o700)
        if args.action == "restore-gate":
            homelab.atomic_file(APP / "data/reconciliation-required", b"Reconcile IS24 history before resuming.\n")
        else:
            status()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"depanator: {error}")
