#!/usr/bin/env python3
"""Scan every image pinned in quadlets/ with one policy for all.

Blocks on unpinned images, scanner errors and CRITICAL findings that have a fix.
HIGH and unfixed findings are reported, not blocking. Full reports: image-security.json.
"""
import json
import os
from pathlib import Path
import re
import subprocess

SCANNER = "docker.io/aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa"
PLATFORM = "linux/arm64"  # the host's architecture; Trivy pulls it remotely from any runner

images = sorted({image for path in Path("quadlets").rglob("*") if path.is_file()
                 for image in re.findall(r"^Image=(.+)$", path.read_text(), re.M)})
reports, rows, failed = [], [], False
for image in images:
    if not re.fullmatch(r"\S+@sha256:[a-f0-9]{64}", image):
        reports.append({"image": image, "error": "not pinned by digest"})
        rows.append(f"| `{image}` | unpinned | | |")
        failed = True
        continue
    result = subprocess.run([
        "podman", "run", "--rm", "--env", "GODEBUG=http2client=0",
        "--volume", "homelab-trivy-cache:/root/.cache/trivy", SCANNER,
        "image", "--image-src", "remote", "--platform", PLATFORM,
        "--scanners", "vuln", "--severity", "HIGH,CRITICAL",
        "--timeout", "5m", "--quiet", "--format", "json", image,
    ], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=360)
    if result.returncode:
        reports.append({"image": image, "error": result.stderr})
        rows.append(f"| `{image}` | scan failed | | |")
        failed = True
        continue
    report = json.loads(result.stdout)
    findings = [v for target in report.get("Results", [])
                for v in target.get("Vulnerabilities") or []]
    blocking = sorted({v["VulnerabilityID"] for v in findings
                       if v["Severity"] == "CRITICAL" and v.get("FixedVersion")})
    critical = sum(v["Severity"] == "CRITICAL" for v in findings)
    high = sum(v["Severity"] == "HIGH" for v in findings)
    reports.append({"image": image, "blocking": blocking, "report": report})
    rows.append(f"| `{image.split('@')[0]}` | {'BLOCKED' if blocking else 'ok'} "
                f"| {critical} | {high} |")
    failed |= bool(blocking)
    print(f"{image.split('@')[0]}: {critical} critical ({len(blocking)} fixable), {high} high",
          flush=True)

Path("image-security.json").write_text(json.dumps(reports, indent=2) + "\n")
if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
    with open(summary, "a") as stream:
        stream.write(f"## Image scan ({PLATFORM}): {'BLOCKED' if failed else 'PASSED'}\n\n"
                     "Blocks on fixable CRITICAL findings, unpinned images and scan errors.\n\n"
                     "| Image | Status | Critical | High |\n| --- | --- | --- | --- |\n"
                     + "\n".join(rows) + "\n")
if failed:
    raise SystemExit("Blocked: fixable CRITICAL findings, unpinned images or failed scans")
