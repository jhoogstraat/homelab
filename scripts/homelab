#!/usr/bin/python3
"""Local application initialization and consistent, encrypted restic backups."""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request


ROOT = Path(os.environ.get("HOMELAB_ROOT", "/var/lib/homelab"))
SOURCE = Path(os.environ.get("HOMELAB_SOURCE", "/usr/share/homelab"))
QUADLETS = Path(os.environ.get("HOMELAB_QUADLETS", "/usr/share/containers/systemd"))
LEGACY_QUADLETS = Path(os.environ.get("HOMELAB_LEGACY_QUADLETS", "/etc/containers/systemd"))
RUN = Path(os.environ.get("HOMELAB_RUN", "/run/homelab"))
RETIRED = ("immobot", "onedev", "n8n", "grafana", "wg-easy", "couchdb")


def command(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


@contextlib.contextmanager
def maintenance():
    RUN.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (RUN / "maintenance.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def atomic_file(path, content, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write(content)
            output.flush()
            os.fchmod(output.fileno(), mode)
            os.fsync(output.fileno())
            temporary.replace(path)
            sync_directory(path.parent)
        finally:
            temporary.unlink(missing_ok=True)


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def copy_files(source, destination, seed=False):
    for path in sorted(source.rglob("*")):
        relative = path.relative_to(source)
        target = destination / relative
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
        elif path.is_file() and (not seed or not target.exists()):
            if not target.exists() or target.read_bytes() != path.read_bytes():
                atomic_file(target, path.read_bytes(), path.stat().st_mode & 0o777)


def prepare():
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o755)
    credentials = ROOT / "credentials"
    credentials.mkdir(exist_ok=True, mode=0o700)
    credentials.chmod(0o700)
    for quadlet in QUADLETS.glob("*.container"):
        app = ROOT / "apps" / quadlet.stem
        (app / "data").mkdir(parents=True, exist_ok=True)
        (app / "config").mkdir(exist_ok=True)
    (ROOT / "apps/papra/ingestion").mkdir(parents=True, exist_ok=True)

    # Git owns environment files; app defaults are copied only when absent.
    copy_files(SOURCE / "environment", ROOT / "environment")
    for path in (ROOT / "environment").rglob("*"):
        if path.is_file() and not (SOURCE / "environment" / path.relative_to(ROOT / "environment")).exists():
            path.unlink()
    key = credentials / "age.key"
    if not key.is_file() or key.stat().st_mode & 0o077:
        raise RuntimeError(f"Provision a root-only age key (0600) at {key}")
    encrypted = sorted((SOURCE / "secrets").glob("*.enc.env"))
    if not encrypted:
        raise RuntimeError("No encrypted secrets in the deployed image")
    digest = hashlib.sha256()
    for path in encrypted:
        digest.update(path.name.encode())
        digest.update(path.read_bytes())
    generations = ROOT / "secret-sets"
    generations.mkdir(exist_ok=True, mode=0o700)
    generations.chmod(0o700)
    generation = generations / digest.hexdigest()
    if not generation.exists():
        with tempfile.TemporaryDirectory(dir=generations) as directory:
            staged = Path(directory)
            env = dict(os.environ, SOPS_AGE_KEY_FILE=str(key))
            for path in encrypted:
                result = command("sops", "decrypt", "--input-type", "dotenv",
                                 "--output-type", "dotenv", str(path),
                                 env=env, stdout=subprocess.PIPE)
                atomic_file(staged / path.name.replace(".enc.env", ".env"), result.stdout)
            # TemporaryDirectory tolerates its directory having been renamed.
            staged.rename(generation)
    secrets = ROOT / "secrets"
    if secrets.exists() and not secrets.is_symlink():
        raise RuntimeError(f"Move the old secrets directory aside before preparing: {secrets}")
    link = ROOT / ".secrets-next"
    link.unlink(missing_ok=True)
    link.symlink_to(generation.relative_to(ROOT))
    link.replace(secrets)
    for app in (SOURCE / "defaults").iterdir():
        if app.is_dir() and app.name != "adguard":
            copy_files(app, ROOT / "apps" / app.name / "config", seed=True)
    adguard = ROOT / "apps/adguard/config/AdGuardHome.yaml"
    if not adguard.exists():
        result = command("sops", "decrypt", "--input-type", "dotenv", "--output-type", "json",
                         str(SOURCE / "secrets/adguard.enc.env"),
                         env=dict(os.environ, SOPS_AGE_KEY_FILE=str(key)), stdout=subprocess.PIPE)
        initial = json.loads(result.stdout)
        if not re.fullmatch(r"\$2[aby]\$\d{2}\$[./A-Za-z0-9]{53}", initial["ADGUARD_PASSWORD_HASH"]):
            raise RuntimeError("AdGuard's initial password must be a bcrypt hash")
        content = (SOURCE / "defaults/adguard/AdGuardHome.yaml").read_text()
        for name in ("ADGUARD_USERNAME", "ADGUARD_PASSWORD_HASH"):
            content = content.replace("${" + name + "}", json.dumps(initial[name]))
        atomic_file(adguard, content.encode())


def units():
    containers = [f"{p.stem}.service" for p in QUADLETS.glob("*.container")]
    pods = [f"{p.stem}-pod.service" for p in QUADLETS.glob("*.pod")]
    # Include retired apps while migrating, so their old writers are quiesced.
    return sorted(containers + pods + [f"{name}.service" for name in RETIRED])


def pause_manifests():
    # Keep compatibility with interrupted maintenance from the old helper.
    return (ROOT / "maintenance/paused-units.json", RUN / "paused-units.json")


def paused_units():
    names = []
    found = False
    for manifest in pause_manifests():
        if manifest.exists():
            found = True
            try:
                entries = json.loads(manifest.read_text())
            except ValueError as error:
                raise RuntimeError(f"Invalid recovery manifest: {manifest}") from error
            if not isinstance(entries, list) or any(
                not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@:-]*\.service", name)
                for name in entries
            ):
                raise RuntimeError(f"Invalid recovery units: {manifest}")
            names.extend(entries)
    return list(dict.fromkeys(names)) if found else None


def save_paused_units(names):
    manifest = pause_manifests()[0]
    manifest.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    manifest.parent.chmod(0o700)
    sync_directory(ROOT)
    atomic_file(manifest, json.dumps(names).encode())


def clear_paused_units():
    for manifest in pause_manifests():
        if manifest.exists():
            manifest.unlink()
            sync_directory(manifest.parent)


MATTER_PROBE = """
const timer = setTimeout(() => process.exit(1), 5000);
const ws = new WebSocket(process.argv[1]);
ws.addEventListener('error', () => process.exit(1));
ws.addEventListener('close', () => process.exit(1));
ws.addEventListener('open', () => ws.send(JSON.stringify({
    message_id: 'homelab-ready', command: 'get_nodes', args: {}
})));
ws.addEventListener('message', event => {
    try {
        const data = JSON.parse(event.data);
        if (data.message_id === 'homelab-ready') {
            clearTimeout(timer);
            process.exit(Array.isArray(data.result) && data.error_code === undefined ? 0 : 1);
        }
    } catch { process.exit(1); }
});
"""


def unit_ready(name):
    try:
        active = subprocess.run(["systemctl", "is-active", "--quiet", name],
                                check=False, timeout=5, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
        if active.returncode:
            return False
        if name == "homeassistant.service":
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            with opener.open("http://127.0.0.1:8123/", timeout=3) as response:
                return response.status == 200
        if name == "matter.service":
            url = "ws://127.0.0.1:5580/ws"
            entries = ROOT / "apps/homeassistant/config/.storage/core.config_entries"
            if entries.exists():
                for entry in json.loads(entries.read_text()).get("data", {}).get("entries", []):
                    if entry.get("domain") == "matter":
                        url = entry.get("data", {}).get("url", url)
                        break
            command("podman", "exec", "matter", "node", "-e", MATTER_PROBE, url,
                    timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if name == "otbr.service":
            result = command("podman", "exec", "otbr", "ot-ctl", "state",
                             timeout=10, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            return result.stdout.splitlines()[0].strip() in (b"router", b"leader", b"child")
        return True
    except (OSError, ValueError, IndexError, urllib.error.URLError,
            subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return False


def wait_ready(names, timeout=120):
    pending = set(names)
    deadline = time.monotonic() + timeout
    while pending:
        pending = {name for name in pending if not unit_ready(name)}
        if not pending:
            return
        if time.monotonic() >= deadline:
            raise RuntimeError("Services did not become ready: " + ", ".join(sorted(pending)))
        time.sleep(2)


def resume():
    names = paused_units()
    if names is not None:
        # Promote old /run intent before restarting, so even failed recovery is durable.
        if pause_manifests()[1].exists():
            save_paused_units(names)
            pause_manifests()[1].unlink()
            sync_directory(RUN)
        if names:
            command("systemctl", "start", *names)
            wait_ready(names)
        clear_paused_units()


def pause():
    if paused_units() is not None:
        raise RuntimeError("A previous backup needs recovery: run homelab resume")
    active = [name for name in units() if subprocess.run(
        ["systemctl", "is-active", "--quiet", name], check=False).returncode == 0]
    # Persist before stopping: recovery must survive both SIGKILL and reboot.
    save_paused_units(active)
    if active:
        command("systemctl", "stop", *active)
        result = command("systemctl", "show", "--property=ActiveState", "--property=Result",
                         *active, stdout=subprocess.PIPE)
        states = [dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
                  for block in result.stdout.decode().strip().split("\n\n")]
        if len(states) != len(active) or any(
            state.get("ActiveState") not in ("inactive", "failed") for state in states
        ):
            raise RuntimeError("Application writers did not stop; refusing backup")
        # Some third-party containers return nonzero on SIGTERM. Enforce clean
        # shutdown for HA without changing those applications' existing policy.
        if any(name == "homeassistant.service" and state.get("Result") != "success"
               for name, state in zip(active, states)):
            raise RuntimeError("Home Assistant did not stop cleanly; refusing backup")
    return active


def capture_recovery(active):
    recovery = ROOT / "recovery"
    recovery.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_file(recovery / "active-units.json", json.dumps(active).encode())
    status = command("bootc", "status", "--json", stdout=subprocess.PIPE)
    atomic_file(recovery / "bootc.json", status.stdout)
    # No container environment/credentials are emitted into the manifest.
    running = command("podman", "ps", "--format", "json", stdout=subprocess.PIPE)
    records = []
    for container in json.loads(running.stdout):
        # Pod infra containers have no application image to restore.
        if container.get("IsInfra"):
            continue
        image = command("podman", "image", "inspect", container["ImageID"],
                        stdout=subprocess.PIPE)
        details = json.loads(image.stdout)[0]
        records.append({"names": container["Names"], "image": container["Image"],
                        "digests": details.get("RepoDigests", []), "id": details["Id"]})
    atomic_file(recovery / "images.json", json.dumps(records, indent=2).encode())


def device_sources():
    sources = []
    for path in ("/var/lib/bluetooth", "/etc/NetworkManager/system-connections",
                 "/etc/machine-id", "/etc/containers/systemd", "/etc/containers/auth.json",
                 "/etc/ostree/auth.json", "/etc/fstab",
                 "/etc/systemd/system/homelab-prepare.service.d",
                 "/etc/systemd/system/homelab-recover.service",
                 "/etc/systemd/system/homelab-backup.service.d",
                 "/etc/systemd/system/podman-auto-update.service.d",
                 "/etc/systemd/system/bootc-fetch-apply-updates.service.d"):
        if Path(path).exists():
            sources.append(path)
    # Reversible device override until the tested helper is packaged in the host image.
    local_helper = ROOT / "maintenance/homelab"
    if local_helper.exists():
        sources.append(str(local_helper))
    sources.extend(str(p) for p in Path("/etc/ssh").glob("ssh_host_*"))
    return sources


def backup():
    # Reject unreachable/uninitialized repositories before interrupting apps.
    command("restic", "snapshots", "--json", stdout=subprocess.DEVNULL)
    if not (ROOT / "apps").is_dir():
        raise RuntimeError("Application storage is absent; refusing an empty backup")
    active = [name for name in units() if subprocess.run(
        ["systemctl", "is-active", "--quiet", name], check=False).returncode == 0]
    capture_recovery(active)
    try:
        pause()
        sources = [str(ROOT / name) for name in ("apps", "credentials", "recovery")]
        # Include device identity and Bluetooth pairings needed after reinstall.
        sources.extend(device_sources())
        command("restic", "backup", "--tag", "homelab", *sources)
    finally:
        resume()
    # Retention happens with applications running and only after a full backup.
    command("restic", "forget", "--tag", "homelab", "--group-by", "host,tags",
            "--keep-daily", "7", "--keep-weekly", "4", "--keep-monthly", "12", "--prune")


def update_apps():
    pending = command("podman", "auto-update", "--dry-run", "--format", "json",
                      stdout=subprocess.PIPE)
    if not any(item.get("Updated") == "pending" for item in json.loads(pending.stdout.strip() or b"[]")):
        return
    # A full backup must succeed before potentially irreversible DB migrations.
    backup()
    command("podman", "auto-update")


def migrate(data, config, secrets):
    destination = ROOT / "apps"
    if destination.exists() and any(destination.iterdir()):
        raise RuntimeError("Destination apps directory is not empty; do not overwrite existing state")
    data = data.resolve(strict=True)
    config = config.resolve(strict=True)
    ROOT.mkdir(parents=True, exist_ok=True)
    RUN.mkdir(parents=True, exist_ok=True, mode=0o700)
    completed = False
    try:
        # Quadlet's --rm deletes the legacy writable layer on stop. Capture it
        # first with Podman's native paused commit, then archive that image.
        retired_image = ROOT / "recovery/immobot-image.tar"
        if subprocess.run(["podman", "container", "exists", "immobot"], check=False).returncode == 0:
            retired_image.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            image = command("podman", "commit", "--pause=true", "--quiet", "immobot",
                            stdout=subprocess.PIPE).stdout.decode().strip()
            command("podman", "save", "--output", str(retired_image), image)
            retired_image.chmod(0o600)
        pause()
        with tempfile.TemporaryDirectory(dir=ROOT, prefix=".migration-") as directory:
            staged = Path(directory) / "apps"
            staged.mkdir()
            for quadlet in QUADLETS.glob("*.container"):
                name = quadlet.stem
                source = data / name
                target = staged / name
                target.mkdir()
                old_target = target / "data"
                if name == "homeassistant":
                    old_target = target / "config"
                elif name == "beszel-ui":
                    source = data / "beszel/data"
                elif name == "beszel-agent":
                    source = data / "beszel/agent"
                elif name == "papra":
                    source = data / "papra/data"
                if source.is_dir():
                    command("rsync", "-aHAX", "--numeric-ids", "--filter=-x security.selinux", f"{source}/", f"{old_target}/")
                old_config = config / name
                if old_config.is_dir() and name in ("adguard", "glance"):
                    command("rsync", "-aHAX", "--numeric-ids", "--filter=-x security.selinux", f"{old_config}/", f"{target / 'config'}/")
                if name == "papra" and (data / "papra/ingestion").exists():
                    command("rsync", "-aHAX", "--numeric-ids", "--filter=-x security.selinux", f"{data / 'papra/ingestion'}/", f"{target / 'ingestion'}/")
                if name == "papra" and (old_config / "papra.env").exists():
                    content = (old_config / "papra.env").read_text()
                    content = "\n".join(line for line in content.splitlines() if line.startswith(
                        ("DOCUMENTS_OCR_LANGUAGES=", "DOCUMENT_STORAGE_MAX_UPLOAD_SIZE=",
                         "INGESTION_FOLDER_IS_ENABLED="))) + "\n"
                    atomic_file(target / "config/app.env", content.encode())
            for app in RETIRED:
                retired = staged / "_retired" / app
                retired.mkdir(parents=True, mode=0o700)
                for source, name in ((data / app, "data"), (config / app, "config")):
                    if source.is_dir():
                        command("rsync", "-aHAX", "--numeric-ids", "--filter=-x security.selinux", f"{source}/", f"{retired / name}/")
            if retired_image.exists():
                retired_image.replace(staged / "_retired/immobot/legacy-image.tar")
            if destination.exists():
                destination.rmdir()
            staged.rename(destination)
        if secrets.is_dir():
            credentials = ROOT / "credentials"
            credentials.mkdir(exist_ok=True, mode=0o700)
            command("rsync", "-aHAX", "--numeric-ids", "--filter=-x security.selinux", f"{secrets}/", f"{credentials / 'legacy-secrets'}/")
        print(f"Copied legacy state to {destination}; original directories remain intact.")
        print("Legacy apps remain stopped. Continue cutover, or run homelab resume to abort.")
        completed = True
    finally:
        if not completed:
            resume()


def retire_legacy():
    """Archive only repository-owned legacy overrides before switching images."""
    if not (ROOT / "apps").is_dir() or not any((ROOT / "apps").iterdir()):
        raise RuntimeError("Migrate application state before retiring legacy units")
    known = [p.name for p in QUADLETS.iterdir() if p.is_file()]
    known.extend(f"{name}.container" for name in RETIRED)
    existing = [LEGACY_QUADLETS / name for name in known if (LEGACY_QUADLETS / name).exists()]
    archive = ROOT / "recovery/legacy-quadlets"
    if archive.exists():
        raise RuntimeError("Legacy Quadlet archive already exists; inspect it before retrying")
    archive.mkdir(parents=True, mode=0o700)
    active = paused_units()
    if active is None:
        active = pause()
    atomic_file(ROOT / "recovery/cutover-active-units.json", json.dumps(active).encode())
    for path in existing:
        shutil.copy2(path, archive / path.name)
    for path in existing:
        path.unlink()
    command("systemctl", "daemon-reload")
    # These are deliberately left stopped until the new image is booted.
    clear_paused_units()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    for name in ("prepare", "backup", "resume", "update-apps", "update-host", "retire-legacy"):
        sub.add_parser(name)
    migration = sub.add_parser("migrate")
    migration.add_argument("--data", type=Path, default=Path("/opt/containers/data"))
    migration.add_argument("--config", type=Path, default=Path("/opt/containers/config"))
    migration.add_argument("--secrets", type=Path, default=Path("/opt/containers/secrets"))
    args = parser.parse_args()
    with maintenance():
        if args.action == "resume":
            resume()
        elif args.action == "prepare":
            prepare()
        elif args.action == "backup":
            backup()
        elif args.action == "update-apps":
            update_apps()
        elif args.action == "update-host":
            backup()
            command("bootc", "upgrade", "--apply")
        elif args.action == "migrate":
            migrate(args.data, args.config, args.secrets)
        elif args.action == "retire-legacy":
            retire_legacy()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"homelab: {error}", file=sys.stderr)
        sys.exit(1)
