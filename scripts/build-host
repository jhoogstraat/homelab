#!/bin/bash
# Executed only while building the host image.
set -xeuo pipefail

cat > /usr/lib/sysusers.d/homelab-users.conf <<-'EOT'
u jh 1000 "Joshua" /var/empty /bin/zsh
m jh wheel
u cockpit 4000 "Rootless unprivileged peasant with password to login to cockpit" /var/empty /bin/bash
u containers - "Podman user namespace allocation" /var/empty /usr/sbin/nologin
EOT

systemd-sysusers /usr/lib/sysusers.d/homelab-users.conf
# libsubid 4.20 resolves range owners through NSS, including rootful UserNS=auto.
for file in /etc/subuid /etc/subgid; do
    if ! grep -q '^containers:' "$file"; then
        printf 'containers:2147483647:2147483648\n' >> "$file"
    fi
done
getsubids containers
getsubids -g containers
usermod --lock root
install -d -m 0755 /usr/share/homelab/ssh
printf '%%wheel ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/wheel-nopasswd
chmod 0440 /etc/sudoers.d/wheel-nopasswd
rm -rf /var/home/jh /var/home/cockpit /tmp/* /var/tmp/*

install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/30-homelab.conf <<-'EOT'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
Match User jh
    AuthorizedKeysFile /usr/share/homelab/ssh/jh.keys
EOT

echo 'pi1.local' > /etc/hostname
ln -snf /usr/share/zoneinfo/Europe/Berlin /etc/localtime
install -d -m 0755 /etc/containers/registries.conf.d /etc/systemd/resolved.conf.d

cat > /etc/containers/registries.conf.d/local_registry.conf <<-'EOT'
[[registry]]
location = "localhost:5000"
insecure = true
EOT

cat > /etc/systemd/resolved.conf.d/custom-dns.conf <<-'EOT'
[Resolve]
DNS=1.1.1.1 8.8.8.8
DNSStubListener=no
EOT

# OpenThread border router on host networking (ot-br-posix setup-host).
cat > /usr/lib/sysctl.d/60-homelab-network.conf <<-'EOT'
net.ipv6.conf.all.disable_ipv6 = 0
net.ipv4.conf.all.forwarding = 1
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.all.accept_ra_rt_info_max_plen = 64
net.ipv6.conf.all.accept_ra = 2
EOT

# https://github.com/matter-js/matterjs-server/main/docs/os_requirements.md
cat > /etc/sysctl.d/99-matter.conf <<-'EOT'
net.ipv6.conf.end0.forwarding=0
net.netfilter.nf_conntrack_udp_timeout_stream=3600
EOT

cat > /usr/lib/tmpfiles.d/homelab-containers.conf <<-'EOT'
d /var/lib/homelab 0755 root root -
d /var/lib/homelab/credentials 0700 root root -
d /var/lib/homelab/maintenance 0700 root root -
d /var/cache/restic 0700 root root -
d /var/lib/PackageKit 0755 root root -
d /var/lib/bluetooth 0700 root root -
d /var/lib/bluetooth/mesh 0755 root root -
d /var/lib/iscsi 0755 root root -
d /var/lib/iscsi/ifaces 0755 root root -
d /var/lib/iscsi/isns 0755 root root -
d /var/lib/iscsi/nodes 0755 root root -
d /var/lib/iscsi/send_targets 0755 root root -
d /var/lib/iscsi/slp 0755 root root -
d /var/lib/iscsi/static 0755 root root -
EOT

systemctl enable chrony-wait.service bluetooth.service cockpit.socket firewalld.service NetworkManager-wait-online.service podman.socket systemd-resolved.service homelab.target homelab-recover.service homelab-backup.timer bootc-fetch-apply-updates.timer
firewall-offline-cmd --zone=public --add-service=cockpit
firewall-offline-cmd --zone=public --add-service=https
firewall-offline-cmd --zone=public --add-service=dns
# Explicit membership lets firewalld forward LAN traffic to the Thread mesh.
firewall-offline-cmd --zone=public --add-interface=wpan0
firewall-offline-cmd --zone=public --add-port=21063-21064/tcp
# Application updates arrive as reviewed digest pins in the host image.
systemctl disable podman-auto-update.timer
rm -rf /run/cockpit /run/selinux-policy /var/lib/dnf /tmp/* /var/tmp/*
# semanage.conf stores the image policy in /etc/selinux. RPM upgrades also
# leave a duplicate build-time store in /var, which bootc must not deploy.
grep -qx 'store-root=/etc/selinux' /etc/selinux/semanage.conf
for policy in /etc/selinux/targeted/policy/policy.*; do
    test -s "$policy"
done
rm -rf /var/lib/selinux /var/lib/rpm-state/kernel
# The bootable kernel/initramfs live in /usr/lib/modules; this is RPM metadata.
rm -f /boot/symvers-*.xz
rm -f /usr/libexec/homelab-build-host
