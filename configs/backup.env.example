# Provision as /var/lib/homelab/credentials/backup.env (root:root, mode 0600).
# Keep an independent recovery copy of the repository password and S3 keys.
RESTIC_REPOSITORY=s3:https://s3.example.com/homelab/pi1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
RESTIC_PASSWORD_FILE=/var/lib/homelab/credentials/restic-password
