[Unit]
Description=Rotate runtime homelab secrets with service recovery
Requires=homelab-prepare.service
After=homelab-prepare.service

[Service]
Type=oneshot
LoadCredential=age.key:/var/lib/homelab/credentials/age.key
ExecStart=/usr/libexec/homelab rotate-secrets
ExecStopPost=/usr/libexec/homelab resume
TimeoutStartSec=10min
TimeoutStopSec=10min
UMask=0077
