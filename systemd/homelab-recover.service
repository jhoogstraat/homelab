[Unit]
Description=Recover homelab applications after interrupted maintenance
Requires=homelab-prepare.service
After=homelab-prepare.service
Before=homelab-backup.service podman-auto-update.service bootc-fetch-apply-updates.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/homelab resume
TimeoutStartSec=10min
UMask=0077

[Install]
WantedBy=multi-user.target
